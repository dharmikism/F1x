{
  "manifest_version": 3,
  "name": "FixOnce — Known fixes",
  "version": "0.1.1",
  "description": "Find previously solved community fixes without repeating the work.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://localhost:8000/*", "https://*/*"],
  "action": {"default_title": "Find a FixOnce solution", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
